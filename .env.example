# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/outils_educsp

# Fournisseur LLM : "cerebras" (API gratuite, rapide) ou "ollama" (self-hosted)
LLM_PROVIDER=cerebras

# Cerebras (cloud.cerebras.ai) — clé API gratuite, sans carte bancaire
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Ollama (self-hosted, utilisé si LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Whisper (self-hosted, transcription audio)
WHISPER_BASE_URL=http://localhost:9000

# Stockage local des fichiers audio uploadés (résolution de audioFileId)
AUDIO_UPLOADS_DIR=./uploads/audio

# Port du serveur HTTP
PORT=3000
