# PostgreSQL
# Deux formes acceptées :
#   postgres://…        un serveur PostgreSQL (usage en établissement)
#   fichier:./donnees   une base embarquée dans ce dossier, sans rien installer
#                       (usage sur un poste, ou à son compte)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/outils_educsp

# Fournisseur LLM : "cerebras" (API gratuite, rapide) ou "ollama" (self-hosted).
# Toute autre valeur empêche le démarrage : ce choix détermine si les
# comptes-rendus sortent ou non de l'infrastructure, il n'est jamais deviné.
LLM_PROVIDER=cerebras

# Cerebras (cloud.cerebras.ai) — clé API gratuite, sans carte bancaire.
# Obligatoire lorsque LLM_PROVIDER=cerebras.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Ollama (self-hosted, utilisé si LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Clés d'activation de la version installée sur téléphone.
#
# Cette version tient ses dossiers sur l'appareil et n'a pas de serveur — mais
# un modèle de langage n'y tient pas. Deux routes lui sont ouvertes ici pour
# rédiger et reformuler ; elles n'écrivent rien, et la clé sert aussi d'identité
# au plafond horaire, pour qu'un appareil ne consomme pas celui des autres.
#
# Liste séparée par des virgules, une clé par appareil. **Vide = fonction
# fermée** : l'application le dit et continue de marcher pour tout le reste.
CLES_ACTIVATION_LOCALE=

# Port du serveur HTTP
PORT=3000

# Note : la transcription vocale ne nécessite aucune configuration serveur.
# Elle s'exécute dans le navigateur (public/transcription.js).
