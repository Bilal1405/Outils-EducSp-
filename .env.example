# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/outils_educsp

# Ollama (self-hosted)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Whisper (self-hosted, transcription audio)
WHISPER_BASE_URL=http://localhost:9000

# Stockage local des fichiers audio uploadés (résolution de audioFileId)
AUDIO_UPLOADS_DIR=./uploads/audio

# Port du serveur HTTP
PORT=3000
