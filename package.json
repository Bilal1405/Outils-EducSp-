{
  "name": "outils-educsp-moteur-bilan",
  "version": "0.1.0",
  "private": true,
  "description": "Moteur de génération de bilans éducatifs trimestriels (PCPE) assisté par IA",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "validate:corpus": "tsx test/validate-corpus.ts",
    "vendor:asr": "node scripts/vendor-asr.mjs",
    "postinstall": "node scripts/vendor-asr.mjs --tolerant"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
